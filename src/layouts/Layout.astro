---
import "../styles/index.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SCU.ASIA - Leading Hoist Crane Experts",
  description = "PT Suksesindo Cahaya Utama is a dynamic company specializing in material handling solutions, hoist crane services, and genuine spare parts across Indonesia.",
} = Astro.props;

// Determine active page from URL path
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isProduct =
  pathname.startsWith("/product") || pathname.startsWith("/elementor-page");
const isServices = pathname.startsWith("/services");
const isProjects = pathname.startsWith("/projects");
const isContact = pathname.startsWith("/contact");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/jpeg"
      href="/images/07_cropped-WhatsApp-Image-2023-07-08-at-09.12.16-32x32.jpeg"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <!-- Header -->
    <header class="header-wrapper">
      <div class="container header-container">
        <a href="/" class="logo-section">
          <img
            src="/images/01_logo.jpg"
            alt="SCU.ASIA Logo"
            class="logo-img"
            width="50"
            height="43"
          />
          <span class="logo-text">PT SUKSESINDO<br />CAHAYA UTAMA</span>
        </a>

        <!-- Desktop Navigation -->
        <nav>
          <ul class="nav-menu">
            <li>
              <a href="/" class:list={["nav-link", { active: isHome }]}>Home</a>
            </li>
            <li>
              <a
                href="/product"
                class:list={["nav-link", { active: isProduct }]}>Product</a>
            </li>
            <li>
              <a
                href="/services"
                class:list={["nav-link", { active: isServices }]}>Services</a>
            </li>
            <li>
              <a
                href="/projects"
                class:list={["nav-link", { active: isProjects }]}>Projects</a>
            </li>
          </ul>
        </nav>

        <div class="header-cta">
          <a href="/contact-us" class="btn btn-outline">Contact Us</a>
        </div>

        <!-- Mobile hamburger -->
        <button class="hamburger" id="hamburger-btn" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- Mobile Drawer Overlay -->
    <div class="mobile-menu-overlay" id="mobile-overlay"></div>

    <!-- Mobile Drawer -->
    <div class="mobile-menu" id="mobile-drawer">
      <ul class="mobile-nav-list">
        <li><a href="/" class="mobile-nav-link">Home</a></li>
        <li><a href="/product" class="mobile-nav-link">Product</a></li>
        <li><a href="/services" class="mobile-nav-link">Services</a></li>
        <li><a href="/projects" class="mobile-nav-link">Projects</a></li>
        <li><a href="/contact-us" class="mobile-nav-link">Contact Us</a></li>
      </ul>
      <div style="margin-top: auto;">
        <a
          href="/contact-us"
          class="btn btn-primary"
          style="display: block; width: 100%;">Get a Quote</a
        >
      </div>
    </div>

    <!-- Main Content -->
    <main style="flex: 1;">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-top">
        <!-- Col 1 -->
        <div class="footer-col">
          <h3>SCU.ASIA</h3>
          <p class="footer-desc">
            PT Suksesindo Cahaya Utama is a dynamic company specializing in
            material handling solutions, hoist crane services, and genuine spare
            parts across Indonesia.
          </p>
          <ul class="social-links">
            <li class="social-link-item">
              <a
                href="https://www.linkedin.com/company/pt-suksesindo-cahaya-utama/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.437-.103.252-.129.604-.129.957v5.411h-3.555V9h3.414v1.561h.046c.477-.9 1.637-1.846 3.37-1.846 2.602 0 4.538 1.703 4.538 5.36v6.377zM5.337 7.433c-1.144 0-2.063-.931-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.134-.924 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                  ></path>
                </svg>
              </a>
            </li>
            <li class="social-link-item">
              <a
                href="https://www.instagram.com/wimac_crane_indonesia_dealer/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.057-1.645.069-4.849.069-3.204 0-3.584-.012-4.849-.069-3.259-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1 1 12.324 0 6.162 6.162 0 0 1-12.324 0zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm4.965-10.322a1.44 1.44 0 1 1 2.881.001 1.44 1.44 0 0 1-2.881-.001z"
                  ></path>
                </svg>
              </a>
            </li>
            <li class="social-link-item">
              <a href="mailto:sales@scu.asia" aria-label="Email">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                  ></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <!-- Col 2 -->
        <div class="footer-col">
          <h3>Wimac Crane</h3>
          <ul class="footer-nav">
            <li><a href="/product">Our Products</a></li>
            <li><a href="/services">Services Overview</a></li>
            <li><a href="/projects">Recent Milestones</a></li>
            <li><a href="/contact-us">Get in Touch</a></li>
          </ul>
        </div>

        <!-- Col 3 -->
        <div class="footer-col">
          <h3>Products</h3>
          <ul class="footer-nav">
            <li><a href="/product#double-girder">Double Girder Crane</a></li>
            <li><a href="/product#single-girder">Single Girder Crane</a></li>
            <li><a href="/product#underslung">Underslung Crane</a></li>
            <li><a href="/product#jib-crane">Jib Crane</a></li>
            <li><a href="/product#monorail">Monorail Crane</a></li>
            <li><a href="/product#gantry">Gantry Crane</a></li>
          </ul>
        </div>

        <!-- Col 4 -->
        <div class="footer-col">
          <h3>Contact Info</h3>
          <div class="footer-contact-item">
            <span class="footer-contact-icon">📞</span>
            <span>+6281389833939</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon">✉️</span>
            <span>sales@scu.asia</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon">📍</span>
            <span>
              <strong>Main Office:</strong><br />
              Perumahan Cikupa Asri Blok G2 No.23 Tangerang-Banten
            </span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon">🛠️</span>
            <span>
              <strong>Workshop:</strong><br />
              Mampir Barat, Cileungsi-Bogor
            </span>
          </div>
        </div>
      </div>

      <div class="footer-copyright">
        <p>
          &copy; {new Date().getFullYear()} PT Suksesindo Cahaya Utama. All rights
          reserved. | www.scu.asia
        </p>
      </div>
    </footer>

    <!-- Client side script for Mobile Menu Drawer -->
    <script>
      const hamburger = document.getElementById("hamburger-btn");
      const drawer = document.getElementById("mobile-drawer");
      const overlay = document.getElementById("mobile-overlay");

      function toggleMenu() {
        drawer.classList.toggle("open");
        overlay.classList.toggle("open");
      }

      if (hamburger && drawer && overlay) {
        hamburger.addEventListener("click", toggleMenu);
        overlay.addEventListener("click", toggleMenu);
      }
    </script>
  </body>
</html>
