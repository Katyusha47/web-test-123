---

<Layout
  title="Project Milestones & Portfolio - SCU.ASIA"
  description="Browse our project portfolio showcasing overhead crane fabrications and installations for Sunrise Steel, Kereta Api Indonesia, LRT Jabodebek, Indah Kiat, and other major industrial clients."
>
  <!-- Banner -->
  <section
    class="page-banner"
    style="background-image: linear-gradient(rgba(13, 61, 75, 0.85), rgba(13, 61, 75, 0.85)), url('/images/01_20240611_102748-768x576.jpg');"
  >
    <div class="container text-center">
      <h1>Project Milestones</h1>
      <p>
        Proven track record of industrial installations and structural
        engineering across Indonesia.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="section">
    <div class="container">
      <div style="max-width: 700px; margin-bottom: 3.5rem;">
        <span class="product-badge">PORTFOLIO</span>
        <h2
          style="font-size: 2.25rem; color: var(--color-teal); margin-bottom: 1rem;"
        >
          Engineering Milestones
        </h2>
        <p style="color: var(--color-text-muted);">
          Our performance and precision are trusted by leading state-owned
          enterprises (BUMN) and major private corporations in manufacturing,
          steel fabrication, logistics, and transport.
        </p>
      </div>

      <div class="projects-grid">
        {
          projects.map((proj) => (
            <div class="project-card">
              <div class="project-img-wrapper">
                <img
                  src={proj.image}
                  alt={proj.title}
                  class="project-img"
                  loading="lazy"
                />
                <div class="project-date">{proj.date}</div>
              </div>
              <div class="project-info">
                <h3>{proj.title}</h3>
                <p>{proj.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sliding Client Logos Section -->
  <ClientLogosSlider />
</Layout>

<style>
  /* Banner */
  .page-banner {
    padding: 6rem 0;
    color: var(--color-text-light);
    background-size: cover;
    background-position: center;
    margin-bottom: var(--spacing-lg);
  }

  .page-banner h1 {
    font-size: 2.75rem;
    margin-bottom: 0.5rem;
  }

  .page-banner p {
    font-size: 1.15rem;
    opacity: 0.9;
    font-weight: 300;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .project-card {
    background-color: var(--color-bg-light);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .project-img-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.08);
  }

  .project-date {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: var(--color-accent);
    color: var(--color-text-light);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .project-info {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-info h3 {
    font-size: 1.15rem;
    color: var(--color-teal);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .project-info p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 300;
    margin-top: auto;
    line-height: 1.4;
  }
</style>
