---
import Layout from "../layouts/Layout.astro";
import ClientLogosSlider from "../components/ClientLogosSlider.astro";

const featuredGallery = [
  {
    src: "/images/01_IMG_20260106_222719-Copy-300x226.jpg",
    title: "Runway Fabrication",
  },
  { src: "/images/01_IMG_2056-300x169.jpg", title: "Electrical Panel" },
  {
    src: "/images/01_WhatsApp-Image-2026-01-20-at-12.53.17-169x300.webp",
    title: "Welding Structure",
  },
  {
    src: "/images/01_WhatsApp-Image-2026-01-20-at-12.55.23-169x300.webp",
    title: "Welding Rail",
  },
  {
    src: "/images/01_cea3464d-dba7-4635-9223-b0500be27138-300x169.webp",
    title: "Wimac Hoist",
  },
  {
    src: "/images/01_IMG-20170618-WA0005-01-300x225.jpeg",
    title: "Installation Jib",
  },
  {
    src: "/images/01_2022-05-21-20-34-16-909-300x260.jpg",
    title: "Runway Structure",
  },
  { src: "/images/01_IMG-20220716-WA0000-225x300.webp", title: "Mini Gantry" },
  {
    src: "/images/01_83519203-9d28-4e18-8494-9f67ddef29ca-300x169.jpg",
    title: "Jumbo Bag Attachment",
  },
  { src: "/images/01_20250103_112350-300x225.webp", title: "Table Lifter" },
  { src: "/images/01_20250302_133421-225x300.jpg", title: "Erection Crane" },
  {
    src: "/images/01_IMG-20250315-WA0104-300x135.jpg",
    title: "Overhead Crane",
  },
];
---

<Layout
  title="PT Suksesindo Cahaya Utama - Leading Hoist Crane Experts"
  description="Established in 2022 by crane experts with over 15 years of experience, we provide premium hoist cranes, custom modifications, rentals, and genuine parts across Indonesia."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div
      class="hero-bg"
      style="background-image: linear-gradient(135deg, rgba(13, 61, 75, 0.9) 30%, rgba(5, 150, 17, 0.4) 100%), url('/images/01_IMG_1214-1024x576.webp');"
    >
    </div>
    <div class="container hero-container">
      <div class="hero-content">
        <h1 class="hero-title">Leading Hoist Crane Experts</h1>
        <p class="hero-lead">Precision in Every Lift. Safety in Every Move.</p>
        <p class="hero-description">
          Delivering effective, efficient, and uncompromising hoist crane
          services for your most ambitious projects. We bring seamless
          integration of global technology and Indonesian craftsmanship at
          competitive prices.
        </p>
        <div class="hero-actions">
          <a href="/services" class="btn btn-primary">Explore Services</a>
          <a href="/contact-us" class="btn btn-outline">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="about-grid">
        <!-- Content -->
        <div class="about-content">
          <span class="section-badge">ABOUT US</span>
          <h2 class="section-title">Leading Crane Experts for Over a Decade</h2>
          <p class="about-text">
            With over 15 years of industry experience, our expert team delivers
            results you can count on. PT Suksesindo Cahaya Utama was established
            in 2022 by a team of young experts previously working with top
            European crane manufacturers. We focus on effective, efficient, and
            safe solutions so you can have complete peace of mind.
          </p>

          <div class="features-list">
            <div class="feature-item">
              <div class="feature-icon-wrapper">
                <img
                  src="/images/images_about-icon01.png"
                  alt="Icon"
                  class="feature-icon"
                  width="44"
                  height="50"
                />
              </div>
              <div class="feature-info">
                <h3>Guaranteed Results</h3>
                <p>
                  Our performance-based model ensures you only pay for results,
                  not just promises.
                </p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon-wrapper">
                <img
                  src="/images/images_about-icon02.png"
                  alt="Icon"
                  class="feature-icon"
                  width="33"
                  height="35"
                />
              </div>
              <div class="feature-info">
                <h3>Quality Services</h3>
                <p>
                  We pride ourselves on a 24-hour response window, ensuring your
                  project never hits a standstill.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Image Collage -->
        <div class="about-collage">
          <div class="collage-main glare-wrapper">
            <img
              src="/images/01_IMG_20260106_223649-Copy.jpg"
              alt="Crane assembly"
              class="collage-img img-1"
            />
          </div>
          <div class="collage-sub">
            <div class="glare-wrapper">
              <img
                src="/images/01_IMG_20260106_221214-1-1024x576.jpg"
                alt="Crane workshop"
                class="collage-img img-2"
              />
            </div>
            <div class="glare-wrapper">
              <img
                src="/images/01_IMG_20260106_223336-Copy.jpg"
                alt="Industrial workspace"
                class="collage-img img-3"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- One Shop Solution Services -->
  <section class="section section-dark">
    <div class="container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
        <span class="section-badge badge-light">OUR SERVICES</span>
        <h2 class="section-title text-light">One Shop Solution</h2>
        <p class="section-desc" style="opacity: 0.9;">
          We provide premium cranes and components, backed by comprehensive
          warranties. Our services include expert in-house structural design and
          professional installation to deliver a seamless, turnkey solution for
          your lifting needs.
        </p>
      </div>

      <div class="services-slider">
        <!-- Card 1 -->
        <div class="service-card">
          <div class="card-icon">
            <img
              src="/images/02_maintenance-150x150.png"
              alt="Maintenance"
              width="48"
              height="48"
            />
          </div>
          <h3>Crane Maintenance</h3>
          <p>
            Our services prioritize safety, reliability, and peak performance to
            significantly reduce operational maintenance burdens. By optimizing
            assets, we keep utility costs lean and predictable.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="service-card">
          <div class="card-icon">
            <img
              src="/images/02_upgrade-150x150.png"
              alt="Upgrade"
              width="48"
              height="48"
            />
          </div>
          <h3>Crane Upgrade</h3>
          <p>
            Give your old cranes a second life. We upgrade your equipment to be
            safer, faster, and more reliable. It’s the cost-effective way to
            improve performance without buying a brand-new machine.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="service-card">
          <div class="card-icon">
            <img
              src="/images/02_modification-150x150.png"
              alt="Modification"
              width="48"
              height="48"
            />
          </div>
          <h3>Crane Modification</h3>
          <p>
            Upgrade your crane’s potential with our custom modification
            services. From extending spans to increasing capacities, we ensure
            your equipment is safe, compliant, and ready for any challenge.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="service-card">
          <div class="card-icon">
            <img
              src="/images/02_rental-150x150.png"
              alt="Rental"
              width="48"
              height="48"
            />
          </div>
          <h3>Crane Rental</h3>
          <p>
            We provide high-quality hoist and crane rentals tailored to your
            operational needs. Our fleet is full-service maintained and ready
            for immediate dispatch.
          </p>
        </div>

        <!-- Card 5 -->
        <div class="service-card">
          <div class="card-icon">
            <img
              src="/images/02_spare-part-icon-150x150.png"
              alt="Spare Parts"
              width="48"
              height="48"
            />
          </div>
          <h3>Crane Spare Parts</h3>
          <p>
            Don’t compromise on safety with substandard parts. We provide a
            complete range of high-quality, genuine hoist crane spare parts,
            designed for long-term durability.
          </p>
        </div>

        <!-- Card 6 -->
        <div class="service-card">
          <div class="card-icon">
            <img
              src="/images/02_relocation-150x150.png"
              alt="Relocation"
              width="48"
              height="48"
            />
          </div>
          <h3>Crane Relocation</h3>
          <p>
            Relocating heavy lifting equipment requires precision and expertise.
            Our team specializes in the safe, efficient, and compliant
            dismantling, transport, and reassembly of cranes.
          </p>
        </div>
      </div>

      <div style="text-align: center; margin-top: 3rem;">
        <a href="/services" class="btn btn-outline">View Details</a>
      </div>
    </div>
  </section>

  <!-- Featured Works Showcase -->
  <section class="section">
    <div class="container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
        <span class="section-badge">PROJECTS & FABRICATION</span>
        <h2 class="section-title">Featured Works & Field Operations</h2>
        <p class="section-desc">
          Take a look at our precision fabrication, installation projects, and
          specialized material handling systems.
        </p>
      </div>

      <div class="featured-grid">
        {
          featuredGallery.map((item) => (
            <div class="featured-item">
              <img
                src={item.src}
                alt={item.title}
                class="featured-img"
                loading="lazy"
              />
              <div class="featured-caption">
                <span>{item.title}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sliding Client Logos Section -->
  <ClientLogosSlider />

  <!-- FAQ Section -->
  <section class="section section-alt">
    <div class="container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
        <span class="section-badge">FAQ</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-desc">
          Find answers to common questions about our hoist crane services,
          maintenance schedules, and spare parts.
        </p>
      </div>

      <div class="faq-list">
        <!-- FAQ 1 -->
        <div class="faq-item">
          <button class="faq-question">
            What types of hoist cranes do you specialize in?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              We specialize in a wide range of cranes, including overhead cranes
              (single and double girder), gantry cranes, jib cranes, monorail
              systems, and custom-engineered material handling systems.
            </div>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-item">
          <button class="faq-question">
            How often should my hoist crane undergo maintenance?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              In accordance with safety standards, we recommend professional
              inspections at least once every 12 months. For heavy-use or
              high-capacity cranes, quarterly or semi-annual maintenance is
              advised to guarantee peak safety and minimize downtime.
            </div>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-item">
          <button class="faq-question">
            Do you supply genuine spare parts?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes, we provide 100% genuine crane spare parts from leading
              European and global manufacturers, complete with warranties and
              compatibility guarantees for all major brands.
            </div>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="faq-item">
          <button class="faq-question">
            What areas do you cover for crane relocation?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              We offer crane relocation services across Indonesia. Our service
              covers engineering assessments, safe dismantling, transport
              logistics, structural reinforcement, re-installation, and
              re-commissioning testing.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section with Image Background -->
  <section
    class="section section-cta text-center"
    style="background-image: linear-gradient(rgba(13, 61, 75, 0.9), rgba(13, 61, 75, 0.9)), url('/images/01_IMG-20260105-WA0142-1.jpg');"
  >
    <div
      class="container"
      style="max-width: 800px; margin: 0 auto; position: relative; z-index: 2;"
    >
      <h2
        style="font-size: 2.25rem; color: var(--color-text-light); margin-bottom: 1.5rem;"
      >
        Have Any Questions For Us?
      </h2>
      <p
        style="font-size: 1.15rem; color: rgba(255,255,255,0.9); margin-bottom: 2.5rem; font-weight: 300;"
      >
        We are here to support your material handling and crane requirements.
        Get in touch with our experts today.
      </p>
      <a
        href="/contact-us"
        class="btn btn-primary"
        style="background-color: var(--color-accent);">Contact Us Now</a
      >
    </div>
  </section>

  <!-- FAQ interactivity script -->
  <script>
    const faqItems = document.querySelectorAll(".faq-item");

    faqItems.forEach((item) => {
      const question = item.querySelector(".faq-question");
      const answer = item.querySelector(".faq-answer");

      question.addEventListener("click", () => {
        const isOpen = item.classList.contains("open");

        // Close other FAQs
        faqItems.forEach((i) => {
          i.classList.remove("open");
          const ans = i.querySelector(".faq-answer") as HTMLElement | null;
          if (ans) ans.style.maxHeight = "0px";
        });

        if (!isOpen) {
          item.classList.add("open");
          const ans = answer as HTMLElement | null;
          if (ans) ans.style.maxHeight = ans.scrollHeight + "px";
        }
      });
    });
  </script>
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    position: relative;
    padding: 8rem 0;
    color: var(--color-text-light);
    display: flex;
    align-items: center;
    min-height: 80vh;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 1;
    transition: transform 10s ease;
  }

  .hero-section:hover .hero-bg {
    transform: scale(1.05);
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 650px;
  }

  .hero-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-lead {
    font-size: 1.5rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    opacity: 0.9;
    font-weight: 300;
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: fadeInUp 0.8s ease-out 0.6s both;
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2.25rem;
    }
    .hero-lead {
      font-size: 1.25rem;
    }
  }

  /* Section Badges */
  .section-badge {
    display: inline-block;
    padding: 0.25rem 1rem;
    background-color: rgba(5, 150, 17, 0.1);
    color: var(--color-primary);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .section-badge.badge-light {
    background-color: rgba(255, 255, 255, 0.15);
    color: var(--color-text-light);
  }

  .section-title {
    font-size: 2.25rem;
    color: var(--color-teal);
    margin-bottom: 1.5rem;
  }

  .section-title.text-light {
    color: var(--color-text-light);
  }

  .section-desc {
    font-size: 1.05rem;
    font-weight: 300;
  }

  /* About Grid */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .about-text {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .feature-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .feature-icon-wrapper {
    background-color: var(--color-teal);
    border-radius: 8px;
    padding: 1rem;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 65px;
    height: 65px;
    flex-shrink: 0;
  }

  .feature-icon {
    object-fit: contain;
  }

  .feature-info h3 {
    font-size: 1.15rem;
    color: var(--color-teal);
    margin-bottom: 0.5rem;
  }

  .feature-info p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 300;
  }

  /* About Image Collage & Glare Effect */
  .about-collage {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .glare-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .glare-wrapper:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(13, 61, 75, 0.25);
  }

  /* Glare light beam - Hover Effect */
  .glare-wrapper::after {
    content: "";
    position: absolute;
    top: -70%;
    left: -70%;
    width: 60%;
    height: 240%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    transition: left 0.75s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
    z-index: 2;
  }

  .glare-wrapper:hover::after {
    left: 140%;
  }

  /* Periodic Ambient Glare Animation */
  .glare-wrapper::before {
    content: "";
    position: absolute;
    top: -70%;
    left: -70%;
    width: 50%;
    height: 240%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    animation: glassShimmer 5s infinite ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .collage-sub .glare-wrapper:nth-child(1)::before {
    animation-delay: 1.8s;
  }

  .collage-sub .glare-wrapper:nth-child(2)::before {
    animation-delay: 3.6s;
  }

  .collage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .glare-wrapper:hover .collage-img {
    transform: scale(1.05);
  }

  .img-1 {
    height: 300px;
  }

  .collage-sub {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .img-2,
  .img-3 {
    height: 180px;
  }

  /* Service Card Icons */
  .card-icon img {
    object-fit: contain;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.15));
  }

  /* Featured Works Grid */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .featured-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .featured-item {
    position: relative;
    height: 170px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .featured-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(13, 61, 75, 0.2);
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .featured-item:hover .featured-img {
    transform: scale(1.08);
  }

  .featured-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.6rem 0.5rem;
    background: linear-gradient(to top, rgba(13, 61, 75, 0.9), transparent);
    color: var(--color-text-light);
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
  }

  /* CTA Section */
  .section-cta {
    position: relative;
    padding: var(--spacing-xl) 0;
    background-size: cover;
    background-position: center;
  }

  @keyframes glassShimmer {
    0% {
      left: -70%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    35% {
      left: 140%;
      opacity: 0;
    }
    100% {
      left: 140%;
      opacity: 0;
    }
  }

  .faq-question {
    font-weight: 600;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
