---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hoist Cranes & Material Handling Products - SCU.ASIA" description="Explore our catalog of high-capacity Double Girder and Single Girder Overhead Cranes, Underslung Cranes, Jib Cranes, Gantry Cranes, and Monorails manufactured to global standards.">
  
  <!-- Banner -->
  <section class="page-banner" style="background-image: linear-gradient(rgba(13, 61, 75, 0.85), rgba(13, 61, 75, 0.85)), url('/images/01_IMG_20260106_221214-1-1024x576.jpg');">
    <div class="container text-center">
      <h1>Our Products</h1>
      <p>Heavy-duty, high-performance lifting solutions engineered for precision and safety.</p>
    </div>
  </section>

  <!-- Products Content -->
  <section class="section">
    <div class="container">
      
      <!-- Product 1: Double Girder Overhead Crane -->
      <div class="product-block" id="double-girder">
        <div class="product-grid">
          <div class="product-content">
            <span class="product-badge">HEAVY DUTY</span>
            <h2>Double Girder Overhead Crane</h2>
            <p class="product-desc">
              A Double Girder Overhead Crane represents a heavy-duty lifting solution engineered for higher capacities, wider spans, and severe duty cycles. By utilizing two parallel girders with a crab/trolley running on top of them, this system maximizes hook height and load stability.
            </p>
            
            <div class="specs-box">
              <h3>Technical Specifications</h3>
              <ul>
                <li><strong>Lifting Capacity:</strong> Up to 100+ Tons</li>
                <li><strong>Span Capability:</strong> Up to 40+ Meters</li>
                <li><strong>Duty Class:</strong> Class D / E / F (Heavy to Severe duty)</li>
                <li><strong>Hoist Type:</strong> Top-running open winch or wire rope hoist</li>
              </ul>
            </div>

            <div class="grid grid-2" style="margin-top: 1.5rem; gap: 1rem;">
              <div class="pro-con-box pro">
                <h4>Advantages</h4>
                <ul>
                  <li>Maximum hook height (hoist sits higher)</li>
                  <li>Ideal for extremely heavy loads and wide spans</li>
                  <li>Customizable platforms and walkway access</li>
                </ul>
              </div>
              <div class="pro-con-box con">
                <h4>Limitations</h4>
                <ul>
                  <li>Higher upfront cost</li>
                  <li>Requires stronger structural supports</li>
                </ul>
              </div>
            </div>
          </div>
          
          <div class="product-media-column">
            <div class="product-media glare-wrapper">
              <img src="/images/03_EQ-1-scaled.png" alt="Double Girder Overhead Crane" class="product-image" />
            </div>
            <div class="product-thumbnails">
              <div class="thumb-wrapper">
                <img src="/images/01_1000237502-01-1-300x169.jpeg" alt="Double Girder in workshop" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_IMG_20260106_221214-1-300x169.jpg" alt="Double Girder crane installation" class="thumb-img" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Product 2: Single Girder Overhead Crane -->
      <div class="product-block" id="single-girder">
        <div class="product-grid inverse">
          <div class="product-media-column">
            <div class="product-media glare-wrapper">
              <img src="/images/01_IMG-20260105-WA0142-2-1024x922.webp" alt="Single Girder Overhead Crane" class="product-image" />
            </div>
            <div class="product-thumbnails thumbs-3">
              <div class="thumb-wrapper">
                <img src="/images/01_retouch_2025111816121134-300x169.jpg" alt="Single Girder hoist" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_IMG_20260106_223336-Copy-225x300.jpg" alt="Single Girder structure" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_Screenshot_2026-01-17-08-12-37-544_com.linkedin.android-edit-240x300.jpg" alt="Single Girder overview" class="thumb-img" />
              </div>
            </div>
          </div>

          <div class="product-content">
            <span class="product-badge">EFFICIENT & VERSATILE</span>
            <h2>Single Girder Overhead Crane</h2>
            <p class="product-desc">
              A Single Girder Overhead Crane is a highly efficient lifting solution designed for versatility and precision in industrial workspaces. Featuring a single bridge girder supported by end trucks, it is the most cost-effective solution for light to medium duty cycles.
            </p>
            
            <div class="specs-box">
              <h3>Technical Specifications</h3>
              <ul>
                <li><strong>Lifting Capacity:</strong> 1 to 20 Tons</li>
                <li><strong>Span Capability:</strong> Up to 30 Meters</li>
                <li><strong>Duty Class:</strong> Class A / B / C (Standby to Moderate duty)</li>
                <li><strong>Hoist Type:</strong> Underhung wire rope or chain hoist</li>
              </ul>
            </div>

            <div class="grid grid-2" style="margin-top: 1.5rem; gap: 1rem;">
              <div class="pro-con-box pro">
                <h4>Advantages</h4>
                <ul>
                  <li>Cost-effective and lightweight</li>
                  <li>Low building wheel loads</li>
                  <li>Fast installation and simple maintenance</li>
                </ul>
              </div>
              <div class="pro-con-box con">
                <h4>Limitations</h4>
                <ul>
                  <li>Reduced hook height compared to double girder</li>
                  <li>Restricted capacity and span</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Product 3: Underslung Crane -->
      <div class="product-block" id="underslung">
        <div class="product-grid">
          <div class="product-content">
            <span class="product-badge">SPACE SAVING</span>
            <h2>Underslung Overhead Crane</h2>
            <p class="product-desc">
              An Underslung Overhead Crane (also known as a Suspension Crane) is a specialized lifting solution where the crane bridge is suspended from the bottom flange of the runway beams, which are attached directly to the building's roof structure.
            </p>
            
            <div class="specs-box">
              <h3>Technical Specifications</h3>
              <ul>
                <li><strong>Lifting Capacity:</strong> Up to 10 Tons</li>
                <li><strong>Mounting:</strong> Suspended from roof rafters/ceiling trusses</li>
                <li><strong>Best Use:</strong> Workspaces with limited head and floor clearance</li>
              </ul>
            </div>

            <div class="grid grid-2" style="margin-top: 1.5rem; gap: 1rem;">
              <div class="pro-con-box pro">
                <h4>Advantages</h4>
                <ul>
                  <li>No floor columns needed (maximizes floor space)</li>
                  <li>Excellent hook approach dimensions</li>
                  <li>Flexible multi-runway configurations</li>
                </ul>
              </div>
              <div class="pro-con-box con">
                <h4>Limitations</h4>
                <ul>
                  <li>Requires heavy-duty roof structure</li>
                  <li>Typically limited to lower load capacities</li>
                </ul>
              </div>
            </div>
          </div>
          
          <div class="product-media-column">
            <div class="product-media glare-wrapper">
              <img src="/images/01_IMG_20241215_153417_849-1024x576.webp" alt="Underslung Crane" class="product-image" />
            </div>
            <div class="product-thumbnails">
              <div class="thumb-wrapper">
                <img src="/images/01_20230708_171242-1-300x225.jpg" alt="Underslung crane rail" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_Screenshot-2026-01-19-193956-284x300.png" alt="Underslung crane profile" class="thumb-img" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Product 4: Jib Crane -->
      <div class="product-block" id="jib-crane">
        <div class="product-grid inverse">
          <div class="product-media-column">
            <div class="product-media glare-wrapper">
              <img src="/images/01_IMG_20260106_223649-Copy.jpg" alt="Jib Crane installation" class="product-image" />
            </div>
            <div class="product-thumbnails thumbs-3">
              <div class="thumb-wrapper">
                <img src="/images/01_dee27525-5f17-4bc3-befb-20717fe1e7df-300x225.jpg" alt="Wall-mounted jib crane" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_IMG-20170618-WA0005-01-300x225.jpeg" alt="Pillar jib crane" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_IMG-20260105-WA0155-300x300.webp" alt="Jib crane hook and hoist" class="thumb-img" />
              </div>
            </div>
          </div>

          <div class="product-content">
            <span class="product-badge">LOCALIZED LIFTING</span>
            <h2>Jib Crane Systems</h2>
            <p class="product-desc">
              A Jib Crane is a highly versatile lifting system featuring a horizontal arm (jib or boom) supporting a movable hoist. It provides localized, ergonomic lifting for workstation cells or machine loading, functioning as an auxiliary device alongside large overhead systems.
            </p>
            
            <div class="specs-box">
              <h3>Jib Configurations</h3>
              <ul>
                <li><strong>Pillar Jib Crane:</strong> Freestanding column anchored to the floor offering 360&deg; rotation.</li>
                <li><strong>Wall-Mounted Jib:</strong> Fixed to building columns/walls, offering 180&deg; to 200&deg; rotation.</li>
                <li><strong>Wall-Traveling Jib:</strong> Moves along tracks on a wall, serving multiple workstations in a row.</li>
                <li><strong>Articulating Jib:</strong> Features a folding boom with a knee joint to navigate around obstructions.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Product 5: Monorail Cranes -->
      <div class="product-block" id="monorail">
        <div class="product-grid">
          <div class="product-content">
            <span class="product-badge">LINEAR TRANSPORT</span>
            <h2>Monorail Cranes</h2>
            <p class="product-desc">
              A Monorail Crane is a specialized system where the hoist and trolley travel along a single stationary runway beam (typically an I-beam). It is highly efficient for production lines, assembly processes, and transport routes with fixed paths.
            </p>
            
            <div class="specs-box">
              <h3>Technical Specifications & Use Cases</h3>
              <ul>
                <li><strong>Lifting Capacity:</strong> Up to 10 Tons</li>
                <li><strong>Track Options:</strong> Straight, curved, or closed-loop tracks</li>
                <li><strong>Applications:</strong> Assembly lines, spray paint booths, dipping tanks, and material supply</li>
              </ul>
            </div>
          </div>

          <div class="product-media-column">
            <div class="product-media glare-wrapper">
              <img src="/images/07_WhatsApp-Image-2023-07-08-at-09.11.46-1024x768.jpeg" alt="Monorail Crane System" class="product-image" />
            </div>
            <div class="product-thumbnails thumbs-3">
              <div class="thumb-wrapper">
                <img src="/images/01_IMG-20260105-WA0141-1-168x300.webp" alt="Monorail hoist" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_721b9d62-cc5e-45ad-bedf-ddfe60a62170-300x225.jpg" alt="Monorail curved track" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_FC55E3B4-F261-4B0A-AB81-C756B08E2207-225x300.webp" alt="Monorail installation" class="thumb-img" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Product 6: Gantry Cranes -->
      <div class="product-block" id="gantry">
        <div class="product-grid inverse">
          <div class="product-media-column">
            <div class="product-media glare-wrapper">
              <img src="/images/01_IMG_20250710_202002_837-1024x1024.webp" alt="Gantry Crane System" class="product-image" />
            </div>
            <div class="product-thumbnails">
              <div class="thumb-wrapper">
                <img src="/images/01_IMG-20220716-WA0000-225x300.webp" alt="Mini Gantry crane" class="thumb-img" />
              </div>
              <div class="thumb-wrapper">
                <img src="/images/01_IMG-20260105-WA0139-225x300.jpg" alt="Gantry crane structure" class="thumb-img" />
              </div>
            </div>
          </div>

          <div class="product-content">
            <span class="product-badge">NO OVERHEAD STRUCTURE</span>
            <h2>Gantry Crane Systems</h2>
            <p class="product-desc">
              Gantry Cranes are overhead cranes supported by self-supporting legs that travel on floor rails or wheels. They eliminate the need for elevated building runways, making them ideal for outdoor yards, shipping docks, and temporary workspaces.
            </p>
            
            <div class="specs-box">
              <h3>Types & Styles</h3>
              <ul>
                <li><strong>Full Gantry:</strong> Runs on floor tracks with dual leg support.</li>
                <li><strong>Semi-Gantry:</strong> One leg on floor tracks, other end on elevated wall rail.</li>
                <li><strong>Portable Gantry:</strong> Lightweight mobile frame on caster wheels.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="section section-teal text-center">
    <div class="container">
      <h2>Need a Custom Crane Engineered?</h2>
      <p style="margin-bottom: 2rem; opacity: 0.9; font-weight: 300;">
        Our team of experienced designers will calculate and design structural spans and capacities to match your workshop perfectly.
      </p>
      <a href="/contact-us" class="btn btn-primary" style="background-color: var(--color-accent);">Get Free Consultation</a>
    </div>
  </section>

</Layout>

<style>
  /* Page Banner */
  .page-banner {
    padding: 6rem 0;
    color: var(--color-text-light);
    background-size: cover;
    background-position: center;
    margin-bottom: var(--spacing-lg);
  }

  .page-banner h1 {
    font-size: 2.75rem;
    margin-bottom: 0.5rem;
  }

  .page-banner p {
    font-size: 1.15rem;
    opacity: 0.9;
    font-weight: 300;
  }

  /* Product Blocks */
  .product-block {
    margin-bottom: 3rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .product-grid.inverse {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .product-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: rgba(5, 150, 17, 0.1);
    color: var(--color-primary);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .product-content h2 {
    font-size: 2rem;
    color: var(--color-teal);
    margin-bottom: 1rem;
  }

  .product-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .specs-box {
    background-color: var(--color-bg-alt);
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-primary);
    border-radius: 0 4px 4px 0;
  }

  .specs-box h3 {
    font-size: 1.1rem;
    color: var(--color-teal);
    margin-bottom: 0.75rem;
  }

  .specs-box ul {
    list-style: none;
  }

  .specs-box li {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.08);
    padding-bottom: 0.25rem;
  }

  .pro-con-box {
    padding: 1.25rem;
    border-radius: 6px;
    font-size: 0.9rem;
  }

  .pro-con-box h4 {
    margin-bottom: 0.5rem;
  }

  .pro-con-box ul {
    padding-left: 1.25rem;
  }

  .pro-con-box li {
    margin-bottom: 0.25rem;
  }

  .pro-con-box.pro {
    background-color: rgba(5, 150, 17, 0.06);
    color: #046b0c;
  }

  .pro-con-box.con {
    background-color: rgba(244, 148, 44, 0.06);
    color: #925310;
  }

  /* Product Media Column */
  .product-media-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Product Media & Glare Effect */
  .product-media {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    height: 280px;
  }

  .product-media:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(13, 61, 75, 0.22);
  }

  /* Glare light beam - Hover Effect */
  .product-media::after {
    content: '';
    position: absolute;
    top: -70%;
    left: -70%;
    width: 60%;
    height: 240%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    transition: left 0.75s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
    z-index: 2;
  }

  .product-media:hover::after {
    left: 140%;
  }

  /* Periodic Ambient Glare Animation */
  .product-media::before {
    content: '';
    position: absolute;
    top: -70%;
    left: -70%;
    width: 50%;
    height: 240%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    animation: glassShimmer 5s infinite ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .product-media:hover .product-image {
    transform: scale(1.05);
  }

  /* Product Thumbnails */
  .product-thumbnails {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .product-thumbnails.thumbs-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .thumb-wrapper {
    height: 90px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    transition: transform var(--transition-fast);
  }

  .thumb-wrapper:hover {
    transform: translateY(-2px);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes glassShimmer {
    0% {
      left: -70%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    35% {
      left: 140%;
      opacity: 0;
    }
    100% {
      left: 140%;
      opacity: 0;
    }
  }

  .divider {
    border: 0;
    height: 1px;
    background-color: var(--color-border);
    margin: 4rem 0;
  }
</style>
